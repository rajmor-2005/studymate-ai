# Database
DATABASE_URL=sqlite:///./studymate.db

# Auth Secret
JWT_SECRET=studymate_super_secret_jwt_key_2026_dev

# Groq API Key (Get your free key from https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_PRIMARY_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant

# Embeddings
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Razorpay Test Credentials (Get from https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_sample_key_id
RAZORPAY_KEY_SECRET=sample_razorpay_secret

# CORS / Frontend Origin
FRONTEND_URL=http://localhost:5173
